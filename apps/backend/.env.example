# Used by prisma.config.ts for `prisma migrate` / `prisma generate`
DATABASE_URL="mysql://ISPwatcher:ExamplePassword@127.0.0.1:3306/speed_nachweis"

# Used at runtime by db/adapter.ts
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER="ISPwatcher"
DATABASE_PASSWORD="ExamplePassword"
DATABASE_NAME="speed_nachweis"

# Used at runtime by config.ts / server.ts
PORT=3000
HOST="0.0.0.0"

# Layer 1 monitoring — used by engine/speedtest-client.ts, which speaks our
# self-hosted LibreSpeed backend's protocol (ping.php/garbage.php/empty.php,
# all resolved against this base).
SPEEDTEST_BASE_URL="http://librespeed.librespeed.svc.cluster.local/backend/"
# SPEEDTEST_DOWNLOAD_CK_SIZE=10
# SPEEDTEST_UPLOAD_BYTES=5000000
# MONITOR_INTERVAL_MINUTES=15

# Layer 2 — where uploaded official protocols and generated complaint PDFs
# are stored. Defaults to ./data locally; production points this at a
# mounted PVC (see apps/speed-nachweis/ in the argocd repo).
# DATA_DIR=./data
