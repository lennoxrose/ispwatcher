generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  // Pinned explicitly: the generator's environment auto-detection for this
  // isn't guaranteed to agree between platforms, which caused the compiled
  // client to reference "./enums.ts" (a file that doesn't exist post-tsc-
  // build — tsc emits .js) in the container build but not locally on
  // Windows. Forcing .js here matches what tsc actually produces.
  importFileExtension  = "js"
}

datasource db {
  provider = "mysql" // MariaDB uses the mysql connector, no separate provider
  // no `url` here anymore — Prisma 7 moved connection config to prisma.config.ts
}

enum CampaignStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED_INSUFFICIENT_DATA
}

model Contract {
  id              Int              @id @default(autoincrement())
  ispName         String
  ispAddress      String
  maxSpeedMbit    Float
  normalSpeedMbit Float
  minSpeedMbit    Float
  createdAt       DateTime         @default(now())
  campaigns       Campaign[]
  monitoringRuns  MonitoringRun[]
  complaintDrafts ComplaintDraft[]
}

// LAYER 1 — continuous self-monitoring. One row per automated speedtest-client
// run against our own server. Documentation only, never the § 57 TKG proof —
// see plans.md §2a/§5 and CLAUDE.md's "label estimates as estimates" rule.
model MonitoringRun {
  id           Int      @id @default(autoincrement())
  contractId   Int
  contract     Contract @relation(fields: [contractId], references: [id])
  timestamp    DateTime @default(now())
  downloadMbit Float
  uploadMbit   Float
  pingMs       Float

  @@index([contractId])
  @@index([contractId, timestamp])
}

model Campaign {
  id               Int               @id @default(autoincrement())
  contractId       Int
  contract         Contract          @relation(fields: [contractId], references: [id])
  status           CampaignStatus    @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  measurements     Measurement[]
  officialProtocol OfficialProtocol?
  complaintDrafts  ComplaintDraft[]

  @@index([contractId])
}

model Measurement {
  id           Int      @id @default(autoincrement())
  campaignId   Int
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  timestamp    DateTime @default(now())
  downloadMbit Float
  uploadMbit   Float
  pingMs       Float
  dayIndex     Int      // 1, 2, or 3 — which calendar day of the campaign

  @@index([campaignId])
  @@index([campaignId, dayIndex])
}

// LAYER 2 — BNetzA's own signed protocol export, stored opaquely as the actual
// legal proof (plans.md §4.4). Never parsed for structured data.
model OfficialProtocol {
  id         Int      @id @default(autoincrement())
  campaignId Int      @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  filePath   String
  uploadedAt DateTime @default(now())
}

enum ComplaintBasis {
  SELF_MONITORING_ONLY
  OFFICIAL_PROTOCOL
}

// Whether claimedReductionPercent tracks the live campaign-measurement
// average (AUTO) or a value the user typed in and locked (MANUAL) — see
// complaint.service.ts. Sticky until explicitly switched back to AUTO.
enum ReductionPercentMode {
  AUTO
  MANUAL
}

model ComplaintDraft {
  id                      Int                  @id @default(autoincrement())
  contractId              Int
  contract                Contract             @relation(fields: [contractId], references: [id])
  campaignId              Int?
  campaign                Campaign?            @relation(fields: [campaignId], references: [id])
  basis                   ComplaintBasis
  pdfPath                 String
  generatedAt             DateTime             @default(now())
  sentAt                  DateTime?
  claimedReductionPercent Float?
  reductionPercentMode    ReductionPercentMode @default(AUTO)

  @@index([contractId])
  @@index([campaignId])
}

// Singleton — always accessed via findFirst()/getOrCreate(), never by a
// hardcoded id. apiToken is deliberately stored in plaintext (not hashed):
// this is a single-user tool and the whole point is the Settings page can
// show/copy it, not just confirm it's set.
model Settings {
  id            Int      @id @default(autoincrement())
  senderName    String   @default("")
  senderAddress String   @default("")
  senderCity    String   @default("")
  apiToken      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}